{
  "name": "slackwater-xyz",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 5174",
    "build": "NITRO_PRESET=cloudflare_module vite build",
    "preview": "wrangler dev -c .output/server/wrangler.json",
    "deploy": "npm run build && wrangler deploy -c .output/server/wrangler.json",
    "test": "vitest run",
    "test:agents": "node tools/check-agent-readiness.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cf-wasm/resvg": "0.4.0",
    "@openwaters/almanac": "0.11.0",
    "@slackwater/database": "1.0.0-beta.20261017",
    "@slackwater/engine": "^1.0.0-beta.6",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "@tanstack/router-plugin": "^1.168.42",
    "destr": "^2.0.5",
    "leaflet": "^1.9.4",
    "marked": "^18.1.1",
    "negotiator": "^1.1.0",
    "nitro": "3.0.260522-beta",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.1.18",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tz-lookup": "^6.1.2",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "fsevents": false
  }
}
